# 1. Base image
FROM node:24-alpine

# 2. Working directory
WORKDIR /app

# 3. Copy dependency files
COPY package*.json ./

# 4. Install dependencies
RUN npm install

# 5. Copy source code
COPY . .

# 6. Expose application port
EXPOSE 8000

# 7. Start development server
CMD ["npm", "run", "start:dev"]