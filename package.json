  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.6"
  },
"lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "cmd /c \"npm --prefix frontend run lint:fix || exit /b 0\"",
      "prettier --write"
    ],
    "server/**/*.ts": [
      "cmd /c \"eslint --fix --max-warnings=0 || exit /b 0\"",
      "prettier --write"
    ]
  }
